{
  "name": "hall-monitor",
  "private": true,
  "description": "Product-neutral moderation and evaluation service (Hall Monitor) shared by EducateOS and PlayTrek.",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/worker/tsconfig.json --noEmit && tsc -p apps/telemetry-worker/tsconfig.json --noEmit",
    "test": "vitest run",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "lint": "pnpm check:boundaries && pnpm typecheck && pnpm openapi:check",
    "openapi": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/openapi.ts",
    "openapi:check": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/openapi.ts --check",
    "shadow-report": "node --experimental-transform-types --disable-warning=ExperimentalWarning packages/shadow-report/src/bin.ts",
    "rollback-drill": "node scripts/rollback-drill.mjs",
    "privacy-preflight": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/privacy-preflight.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
