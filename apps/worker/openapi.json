                "items": {
                  "type": "string",
                  "maxLength": 96,
                  "pattern": "^[a-z][a-z0-9_.]*$"
                }
              }
            },
            "required": [
              "decision",
              "reasonCodes"
            ]
          }
        },
        "required": [
          "schemaVersion",
          "evaluationId",
          "requestId",
          "decision",
          "reasonCodes",
          "findings",
          "uncertain",
          "policyRevision",
          "evaluatorBundleRevision",
          "resolverVersion",
          "receipt"
        ]
      },
      "Finding": {
