// Hall Monitor Worker. Holds no secrets: issuer public keys, the audience and policy overlays
// are plain configuration; set them per environment with `vars` or the dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hall-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "IDEMPOTENCY_STORE", "class_name": "IdempotencyStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IdempotencyStore"] }],
  // Per-tenant limit; the Worker keys it by the verified token's tenant.
  "ratelimits": [
    { "name": "TENANT_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } }
  ],
  "vars": {
    "HM_AUDIENCE": "hall-monitor",
    // Set per environment: [{"iss": "...", "jwks": {"keys": [...]}, "audiences": ["..."]}]
    "HM_TRUSTED_ISSUERS": "",
    "HM_POLICY_OVERLAYS": "",
    "HM_AI_GATEWAY_ID": ""
  }
}
