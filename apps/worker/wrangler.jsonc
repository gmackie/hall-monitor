// Hall Monitor Worker. Issuer public keys, the audience and policy overlays are plain
// configuration; set them per environment with `vars` or the dashboard. One secret is required:
// `wrangler secret put HM_DIGEST_KEY` (32+ random characters) keys the stored request digests.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hall-monitor",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "IDEMPOTENCY_STORE", "class_name": "IdempotencyStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IdempotencyStore"] }],
  // Per-tenant limit; the Worker keys it by the verified token's tenant.
  "ratelimits": [
    { "name": "TENANT_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 600, "period": 60 } }
  ],
  "vars": {
    "HM_AUDIENCE": "hall-monitor",
    // Set per environment: [{"iss": "...", "jwks": {"keys": [...]}, "audiences": ["..."]}]
    "HM_TRUSTED_ISSUERS": "",
    "HM_POLICY_OVERLAYS": "",
    // Optional: {"tenant": "shadow" | "enforce" | {"mode": "shadow", "allowStudentShadow": true}}.
    // Unlisted tenants are enforced. Student profiles with required moderation are never
    // shadowed without allowStudentShadow (see docs/launch/launch-checklist.md).
    "HM_TENANT_MODES": "",
    "HM_AI_GATEWAY_ID": ""
  }
}
