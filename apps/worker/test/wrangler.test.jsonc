// Test-only configuration: the production config minus the bindings that would need a real
// Cloudflare account (AI, rate limiting). Tests inject fakes for those through test/entry.ts.
// The Vitest runner itself needs nodejs_compat; the Worker does not.
{
  "name": "hall-monitor-test",
  "main": "./entry.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "IDEMPOTENCY_STORE", "class_name": "IdempotencyStore" },
      { "name": "TOKEN_REPLAY_GUARD", "class_name": "TokenReplayGuard" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["IdempotencyStore"] },
    { "tag": "v2", "new_sqlite_classes": ["TokenReplayGuard"] }
  ],
  "vars": { "HM_AUDIENCE": "hall-monitor" }
}
