// Internal telemetry receiver. v1 (/internal/v1/telemetry) validates and DISCARDS (T1). v2
// (/internal/v2/telemetry, HM-21) is an opt-in exact-aggregate route backed by one SQLite Durable
// Object per tenant; it stays OFF until HM_TELEMETRY_V2_ACCEPT=aggregate is set as a secret.
// No public routes and no workers.dev: the only way in is an internal service binding.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hall-monitor-telemetry",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [
      { "name": "AGGREGATES", "class_name": "TelemetryAggregateStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TelemetryAggregateStore"] }
  ]
  // No HM_TELEMETRY_ACCEPT, HM_TELEMETRY_TENANTS, HM_TELEMETRY_V2_ACCEPT or
  // HM_TELEMETRY_V2_TENANTS defaults: all are secrets, set only after independent approval.
  // v2 tenant grants name the approved producer revisions and the source/grade bands.
  // No WAE, D1, R2, Queue, service or Logpush binding is present, and none may be added here.
  // HM_TELEMETRY_V2_CONFIG (W8a) is likewise a secret with no default: the district zone, calendar,
  // approved producer revisions and the operator-approved retention policy. Without a valid one the
  // v2 route stores nothing. Do not enrol a real tenant before retention is approved and W8b lands.
}
